<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: lets the embedded-tag source find local files in MediaStore. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
        Signature|privileged: never granted to a Play/sideloaded app. Declared only so a
        system-image build (e.g. an OEM head unit) can use MediaSessionManager directly. Regular
        installs read sessions through the enabled NotificationListenerService instead.
    -->
    <uses-permission
        android:name="android.permission.MEDIA_CONTENT_CONTROL"
        tools:ignore="ProtectedPermissions" />

    <!-- Car App Library: surface access for the full-screen lyrics renderer. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- Vehicle speed, used to switch the car UI into its glanceable driving layout. -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />

    <application
        android:name=".LyricDriveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LyricDrive">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LyricDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants MediaSessionManager.getActiveSessions() for third-party players. -->
        <service
            android:name=".service.LyricsNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Media-card mirror: shows the current lyric line in Android Auto's media card and
            split-screen widget, i.e. *alongside* Google Maps / Waze.
        -->
        <service
            android:name=".service.LyricsMirrorMediaService"
            android:enabled="${mediaServiceEnabled}"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Full-screen lyrics on the car display (Car App Library, surface rendering). -->
        <!--
            Car App Library services (car variant). The category decides where Android Auto puts
            the app and is fixed per component, so there are two twins and only one is enabled at a
            time (AndroidAutoComponents):
            - WEATHER (default): Maps keeps the navigation slot; lyrics run beside it in split view.
            - NAVIGATION: lyrics take the navigation slot, replacing Maps.
            Both draw on the full-bleed NavigationTemplate surface (NAVIGATION_TEMPLATES + ACCESS_SURFACE).
        -->
        <service
            android:name=".car.LyricsWeatherCarAppService"
            android:enabled="${carServiceEnabled}"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.WEATHER" />
            </intent-filter>
        </service>
        <service
            android:name=".car.LyricsCarAppService"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/car_app_label"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />
    </application>
</manifest>
